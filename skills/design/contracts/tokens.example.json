{
  "$description": "Harness token contract: DTCG 2025.10 values + harness extensions. Example, not a design.",
  "color": {
    "$type": "color",
    "surface":    { "$value": "#f7f7f5", "$extensions": { "harness.provenance": { "source": "manual", "capturedAt": "2026-10-20", "method": "manual", "confidence": 1.0 } } },
    "on-surface": { "$value": "#16181d" },
    "accent":     { "$value": "#0b5fff" },
    "on-accent":  { "$value": "#ffffff" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 100, "unit": "ms" } },
      "quick":   { "$value": { "value": 150, "unit": "ms" } },
      "base":    { "$value": { "value": 220, "unit": "ms" } },
      "slow":    { "$value": { "value": 360, "unit": "ms" } },
      "scene":   { "$value": { "value": 600, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0.05, 0.7, 0.1, 1] },
      "accelerate": { "$value": [0.3, 0, 0.8, 0.15] }
    },
    "transition": {
      "$type": "transition",
      "feedback": { "$value": { "duration": "{motion.duration.quick}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{motion.easing.standard}" } },
      "enter":    { "$value": { "duration": "{motion.duration.base}",  "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{motion.easing.decelerate}" } },
      "exit":     { "$value": { "duration": "{motion.duration.quick}", "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{motion.easing.accelerate}" } }
    },
    "spring": {
      "$description": "Optional. Overshoot allowed only via a declared spring.",
      "bouncy": { "$type": "cubicBezier", "$value": [0.42, 1.67, 0.21, 0.9],
        "$extensions": { "harness.motion.spring": { "stiffness": 380, "damping": 24 } } }
    }
  },
  "$extensions": {
    "harness.modes": {
      "$description": "Resolver-style contexts. Every listed permutation is contrast-checked.",
      "theme": ["light", "dark"],
      "contrast": ["default", "high"],
      "overrides": {
        "dark": { "color.surface": "#101216", "color.on-surface": "#eef0f3", "color.accent": "#6ea0ff", "color.on-accent": "#0a0c10" }
      }
    },
    "harness.contrastPairs": [
      ["color.on-surface", "color.surface", 4.5],
      ["color.on-accent", "color.accent", 4.5]
    ]
  }
}
